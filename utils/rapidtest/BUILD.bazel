load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "go_test")

go_library(
    name = "rapidtest",
    testonly = True,
    srcs = [
        "rapidtest.go",
        "tb.go",
    ],
    importpath = "github.com/ava-labs/avalanchego/utils/rapidtest",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@net_pgregory_rapid//:rapid",
    ],
)

go_test(
    name = "rapidtest_test",
    srcs = [
        "rapidtest_test.go",
        "tb_test.go",
    ],
    embed = [":rapidtest"],
    deps = [
        "//utils/logging",
        "//utils/logging/loggingtest",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@net_pgregory_rapid//:rapid",
    ],
)
