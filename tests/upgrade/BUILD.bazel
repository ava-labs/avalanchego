load("//.bazel:defs.bzl", "go_test")

go_test(
    name = "upgrade_test",
    srcs = ["upgrade_test.go"],
    tags = ["manual"],  # keep
    deps = [
        "//tests/fixture/e2e",
        "//tests/fixture/tmpnet",
        "//tests/fixture/tmpnet/flags",
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_stretchr_testify//require",
    ],
)

genrule(
    name = "upgrade_test_binary",
    testonly = True,
    srcs = [":upgrade_test"],
    outs = ["upgrade.test"],
    cmd = "cp $< $@",
    tags = ["manual"],
)

sh_binary(
    name = "runner",
    testonly = True,
    srcs = ["//scripts:tests.upgrade.bazel.sh"],
    args = [
        "$(location //main:avalanchego)",
        "$(location :upgrade_test_binary)",
        "$(location @com_github_onsi_ginkgo_v2//ginkgo:ginkgo)",
    ],
    data = [
        ":upgrade_test_binary",
        "//main:avalanchego",
        "//scripts:tests.upgrade.sh",
        "@com_github_onsi_ginkgo_v2//ginkgo",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
