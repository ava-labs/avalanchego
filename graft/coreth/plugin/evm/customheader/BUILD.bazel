load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "graft_go_test")

package(default_visibility = [
    "//graft/coreth:__subpackages__",
    "//graft/coreth:external_consumers",
])

go_library(
    name = "customheader",
    srcs = ["extra.go"],
    importpath = "github.com/ava-labs/avalanchego/graft/coreth/plugin/evm/customheader",
    deps = [
        "//graft/coreth/params/extras",
        "//graft/coreth/plugin/evm/upgrade/ap3",
        "//vms/evm/acp176",
    ],
)

graft_go_test(
    name = "customheader_test",
    srcs = ["extra_test.go"],
    embed = [":customheader"],
    deps = [
        "//graft/coreth/params/extras",
        "//graft/coreth/plugin/evm/upgrade/ap3",
        "//vms/evm/acp176",
        "//vms/saevm/cchain/libevm/customtypes",
        "@com_github_stretchr_testify//require",
    ],
)
