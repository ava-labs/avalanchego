load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "graft_go_test")

package(default_visibility = [
    "//graft/coreth:__subpackages__",
    "//graft/coreth:external_consumers",
])

go_library(
    name = "params",
    srcs = [
        "config_extra.go",
        "config_libevm.go",
        "hooks_libevm.go",
    ],
    importpath = "github.com/ava-labs/avalanchego/graft/coreth/params",
    deps = [
        "//graft/coreth/nativeasset",
        "//graft/coreth/params/extras",
        "//graft/coreth/plugin/evm/customtypes",
        "//graft/coreth/precompile/contract",
        "//graft/coreth/precompile/contracts/warp",
        "//graft/coreth/precompile/precompileconfig",
        "//graft/evm/precompileconfig",
        "//snow",
        "//utils/set",
        "//vms/evm/predicate",
        "//vms/saevm/cchain/cparams",
        "//vms/saevm/hook",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//core/vm",
        "@com_github_ava_labs_libevm//libevm",
        "@com_github_ava_labs_libevm//libevm/legacy",
        "@com_github_ava_labs_libevm//params",
    ],
)

graft_go_test(
    name = "params_test",
    srcs = [
        "hooks_libevm_test.go",
        "main_test.go",
        "protocol_params_test.go",
    ],
    embed = [":params"],
    deps = [
        "//graft/coreth/params/extras",
        "//vms/saevm/cchain/cparams",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//params",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
