load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "graft_go_test")

package(default_visibility = [
    "//graft/coreth:__subpackages__",
    "//graft/coreth:external_consumers",
])

go_library(
    name = "extras",
    srcs = [
        "config.go",
        "network_upgrades.go",
    ],
    importpath = "github.com/ava-labs/avalanchego/graft/coreth/params/extras",
    deps = [
        "//graft/evm/utils",
        "//snow",
        "//upgrade",
        "@com_github_ava_labs_libevm//params",
    ],
)

graft_go_test(
    name = "extras_test",
    srcs = ["config_extra_test.go"],
    embed = [":extras"],
    deps = [
        "//graft/evm/utils",
        "@com_github_stretchr_testify//require",
    ],
)
