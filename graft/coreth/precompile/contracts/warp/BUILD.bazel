load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "graft_go_test")

package(default_visibility = [
    "//graft/coreth:__subpackages__",
    "//graft/coreth:external_consumers",
])

go_library(
    name = "warp",
    srcs = [
        "config.go",
        "contract.go",
        "contract_warp_handler.go",
    ],
    embedsrcs = ["IWarpMessenger.abi"],
    importpath = "github.com/ava-labs/avalanchego/graft/coreth/precompile/contracts/warp",
    deps = [
        "//graft/coreth/precompile/contract",
        "//graft/coreth/precompile/precompileconfig",
        "//utils/constants",
        "//vms/evm/predicate",
        "//vms/platformvm/warp",
        "//vms/platformvm/warp/payload",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//common/math",
        "@com_github_ava_labs_libevm//core/types",
        "@com_github_ava_labs_libevm//core/vm",
        "@com_github_ava_labs_libevm//log",
    ],
)

graft_go_test(
    name = "warp_test",
    srcs = [
        "contract_test.go",
        "export_test.go",
        "predicate_test.go",
    ],
    embed = [":warp"],
    deps = [
        "//graft/coreth/params/extras",
        "//graft/coreth/precompile/contract",
        "//graft/coreth/precompile/precompileconfig",
        "//graft/coreth/precompile/precompiletest",
        "//ids",
        "//snow",
        "//snow/engine/snowman/block",
        "//snow/snowtest",
        "//snow/validators",
        "//snow/validators/validatorstest",
        "//upgrade",
        "//upgrade/upgradetest",
        "//utils",
        "//utils/constants",
        "//utils/crypto/bls",
        "//utils/crypto/bls/signer/localsigner",
        "//utils/math",
        "//utils/set",
        "//vms/evm/predicate",
        "//vms/platformvm/warp",
        "//vms/platformvm/warp/payload",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//core/vm",
        "@com_github_stretchr_testify//require",
    ],
)
