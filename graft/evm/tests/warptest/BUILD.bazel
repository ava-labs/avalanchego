load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "graft_go_test")

go_library(
    name = "warptest",
    srcs = ["aggregate.go"],
    importpath = "github.com/ava-labs/avalanchego/graft/evm/tests/warptest",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//snow/validators",
        "//tests/fixture/tmpnet",
        "//utils/crypto/bls",
        "//utils/crypto/bls/signer/localsigner",
        "//utils/set",
        "//vms/platformvm/warp",
    ],
)

graft_go_test(
    name = "warptest_test",
    srcs = ["aggregate_test.go"],
    embed = [":warptest"],
    deps = [
        "//ids",
        "//snow/validators",
        "//tests/fixture/tmpnet",
        "//vms/platformvm/warp",
        "@com_github_stretchr_testify//require",
    ],
)
