load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "graft_go_test")

package(default_visibility = [
    "//graft/subnet-evm:__subpackages__",
    "//graft/subnet-evm:external_consumers",
])

go_library(
    name = "stateupgrade",
    srcs = ["state_upgrade.go"],
    importpath = "github.com/ava-labs/avalanchego/graft/subnet-evm/stateupgrade",
    deps = [
        "//graft/evm/utils",
        "//utils",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//common/hexutil",
        "@com_github_ava_labs_libevm//common/math",
        "@com_github_ava_labs_libevm//core/state",
        "@com_github_ava_labs_libevm//params",
        "@com_github_holiman_uint256//:uint256",
    ],
)

graft_go_test(
    name = "stateupgrade_test",
    srcs = ["state_upgrade_test.go"],
    embed = [":stateupgrade"],
    deps = ["@com_github_stretchr_testify//require"],
)
