load("//.bazel:defs.bzl", "graft_go_test")

package(default_visibility = [
    "//graft/subnet-evm:__subpackages__",
    "//graft/subnet-evm:external_consumers",
])

graft_go_test(
    name = "warp_test",
    srcs = ["warp_test.go"],
    embedsrcs = ["genesis.json"],
    tags = ["manual"],  # keep
    deps = [
        "//api/info",
        "//graft/subnet-evm/accounts/abi/bind",
        "//graft/subnet-evm/cmd/simulator/key",
        "//graft/subnet-evm/cmd/simulator/load",
        "//graft/subnet-evm/cmd/simulator/metrics",
        "//graft/subnet-evm/cmd/simulator/txs",
        "//graft/subnet-evm/ethclient",
        "//graft/subnet-evm/params",
        "//graft/subnet-evm/precompile/contracts/warp",
        "//graft/subnet-evm/precompile/contracts/warp/warpbindings",
        "//graft/subnet-evm/precompile/contracts/warp/warptest/bindings",
        "//graft/subnet-evm/tests/utils",
        "//graft/subnet-evm/warp",
        "//ids",
        "//snow/validators",
        "//tests/fixture/e2e",
        "//tests/fixture/tmpnet",
        "//vms/evm/predicate",
        "//vms/platformvm",
        "//vms/platformvm/api",
        "//vms/platformvm/warp",
        "//vms/platformvm/warp/payload",
        "@com_github_ava_labs_libevm//:libevm",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//core/types",
        "@com_github_ava_labs_libevm//crypto",
        "@com_github_ava_labs_libevm//log",
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_stretchr_testify//require",
    ],
)

genrule(
    name = "warp_test_binary",
    testonly = True,
    srcs = [":warp_test"],
    outs = ["warp.test"],
    cmd = "cp $< $@",
    tags = ["manual"],
)

sh_binary(
    name = "runner",
    testonly = True,
    srcs = ["//graft/subnet-evm/scripts:tests.e2e.bazel.sh"],
    args = [
        "$(location //main:avalanchego)",
        "$(location //graft/subnet-evm/plugin)",
        "$(location :warp_test_binary)",
    ],
    data = [
        ":warp_test_binary",
        "//graft/subnet-evm/plugin",
        "//graft/subnet-evm/scripts:vm_constants.sh",
        "//main:avalanchego",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
