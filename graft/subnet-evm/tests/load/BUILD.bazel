load("//.bazel:defs.bzl", "graft_go_test")

package(default_visibility = [
    "//graft/subnet-evm:__subpackages__",
    "//graft/subnet-evm:external_consumers",
])

graft_go_test(
    name = "load_test",
    srcs = ["load_test.go"],
    tags = ["manual"],  # keep
    deps = [
        "//graft/subnet-evm/tests",
        "//graft/subnet-evm/tests/utils",
        "//ids",
        "//tests/fixture/e2e",
        "//tests/fixture/tmpnet",
        "//utils/set",
        "@com_github_ava_labs_libevm//log",
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_stretchr_testify//require",
    ],
)

genrule(
    name = "load_test_binary",
    testonly = True,
    srcs = [":load_test"],
    outs = ["load.test"],
    cmd = "cp $< $@",
)

sh_binary(
    name = "runner",
    testonly = True,
    srcs = ["//graft/subnet-evm/scripts:tests.e2e.bazel.sh"],
    args = [
        "$(location //main:avalanchego)",
        "$(location //graft/subnet-evm/plugin)",
        "$(location :load_test_binary)",
        "$(location //graft/subnet-evm/cmd/simulator/main)",
    ],
    data = [
        ":load_test_binary",
        "//graft/subnet-evm/cmd/simulator/main",
        "//graft/subnet-evm/plugin",
        "//graft/subnet-evm/scripts:run.sh",
        "//graft/subnet-evm/scripts:run_simulator.sh",
        "//main:avalanchego",
    ],
    visibility = ["//visibility:public"],
)
