load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "graft_go_test")

package(default_visibility = [
    "//graft/subnet-evm:__subpackages__",
    "//graft/subnet-evm:external_consumers",
])

go_library(
    name = "dummy",
    srcs = ["consensus.go"],
    importpath = "github.com/ava-labs/avalanchego/graft/subnet-evm/consensus/dummy",
    deps = [
        "//graft/evm/utils",
        "//graft/subnet-evm/consensus",
        "//graft/subnet-evm/params",
        "//graft/subnet-evm/params/extras",
        "//graft/subnet-evm/plugin/evm/customheader",
        "//graft/subnet-evm/plugin/evm/customtypes",
        "//graft/subnet-evm/plugin/evm/vmerrors",
        "//vms/saevm/cchain/dynamic",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//core/state",
        "@com_github_ava_labs_libevm//core/types",
        "@com_github_ava_labs_libevm//trie",
    ],
)

graft_go_test(
    name = "dummy_test",
    srcs = ["consensus_test.go"],
    embed = [":dummy"],
    deps = [
        "//graft/subnet-evm/plugin/evm/customheader",
        "//graft/subnet-evm/plugin/evm/customtypes",
        "//utils",
        "//vms/components/gas",
        "@com_github_ava_labs_libevm//core/types",
        "@com_github_stretchr_testify//require",
    ],
)
