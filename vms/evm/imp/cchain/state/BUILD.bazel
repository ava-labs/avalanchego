        "//vms/evm/evmclient",
        "//vms/evm/imp/cchain/libevmextras",
        "//vms/evm/imp/cchain/libevmextras/customtypes",
        "//vms/evm/imp/cchain/tx",
        "//vms/evm/imp/cchain/tx/txtest",
        "//vms/evm/saetest",
