load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "go_test")

go_library(
    name = "warp",
    srcs = ["warp.go"],
    importpath = "github.com/ava-labs/avalanchego/vms/evm/imp/cchain/warp",
    visibility = ["//visibility:public"],
    deps = [
        "//graft/coreth/precompile/contracts/warp",
        "//graft/evm/precompileconfig",
        "//graft/evm/predicate",
        "//snow",
        "//snow/engine/snowman/block",
        "//utils/set",
        "//vms/platformvm/warp",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//core/types",
        "@org_golang_x_sync//errgroup",
    ],
)

go_test(
    name = "warp_test",
    srcs = ["warp_test.go"],
    embed = [":warp"],
    deps = [
        "//codec",
        "//graft/coreth/precompile/contracts/warp",
        "//graft/evm/predicate",
        "//ids",
        "//snow/engine/snowman/block",
        "//snow/snowtest",
        "//utils",
        "//utils/constants",
        "//utils/set",
        "//vms/evm/imp/warp/warptest",
        "//vms/platformvm/warp",
        "//vms/platformvm/warp/payload",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//core/types",
        "@com_github_stretchr_testify//require",
        "@org_uber_go_goleak//:goleak",
    ],
)

package(default_visibility = [
    "//vms/evm/imp/cchain:__subpackages__",
    "//vms/evm/imp/cchain:external_consumers",
])
