load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "go_test")

package(default_visibility = [
    "//vms/saevm/cchain:__subpackages__",
    "//vms/saevm/cchain:external_consumers",
])

go_library(
    name = "cparams",
    srcs = [
        "config.go",
        "precompile_upgrade.go",
    ],
    importpath = "github.com/ava-labs/avalanchego/vms/saevm/cchain/cparams",
    visibility = ["//visibility:public"],
    deps = [
        "//graft/coreth/precompile/precompileconfig",
        "//snow",
        "//upgrade",
        "@com_github_ava_labs_libevm//params",
    ],
)

go_test(
    name = "cparams_test",
    srcs = ["config_test.go"],
    deps = [
        ":cparams",
        "//graft/coreth/params",
        "//snow/snowtest",
        "@com_github_arr4n_shed//testerr",
        "@com_github_ava_labs_libevm//params",
        "@com_github_stretchr_testify//require",
    ],
)
