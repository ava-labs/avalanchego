load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "go_test")

go_library(
    name = "crosschain",
    srcs = [
        "contract.go",
        "module.go",
    ],
    embedsrcs = ["ICrossChainTransfer.abi"],
    importpath = "github.com/ava-labs/avalanchego/vms/saevm/cchain/crosschain",
    visibility = ["//visibility:public"],
    deps = [
        "//cache/lru",
        "//graft/coreth/precompile/contract",
        "//graft/coreth/precompile/modules",
        "//graft/coreth/precompile/precompileconfig",
        "//ids",
        "//utils/constants",
        "//vms/components/avax",
        "//vms/saevm/cchain/tx",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//common/math",
        "@com_github_ava_labs_libevm//core/types",
        "@com_github_ava_labs_libevm//core/vm",
        "@com_github_ava_labs_libevm//params",
        "@com_github_holiman_uint256//:uint256",
    ],
)

go_test(
    name = "crosschain_test",
    srcs = ["contract_test.go"],
    embed = [":crosschain"],
    deps = [
        "//ids",
        "//utils/constants",
        "//vms/components/avax",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//core/types",
        "@com_github_stretchr_testify//require",
    ],
)
