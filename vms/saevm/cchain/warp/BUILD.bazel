load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "go_test")

go_library(
    name = "warp",
    srcs = ["warp.go"],
    importpath = "github.com/ava-labs/avalanchego/vms/saevm/cchain/warp",
    visibility = ["//visibility:public"],
    deps = [
        "//graft/coreth/params/extras",
        "//graft/coreth/precompile/contracts/warp",
        "//graft/coreth/precompile/precompileconfig",
        "//snow",
        "//snow/engine/snowman/block",
        "//vms/evm/predicate",
        "//vms/platformvm/warp",
        "//vms/saevm/warp",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//core/types",
    ],
)

go_test(
    name = "warp_test",
    srcs = ["warp_test.go"],
    embed = [":warp"],
    deps = [
        "//codec",
        "//graft/coreth/params/extras",
        "//graft/coreth/precompile/contracts/warp",
        "//graft/coreth/precompile/precompileconfig",
        "//ids",
        "//snow/engine/snowman/block",
        "//snow/snowtest",
        "//utils",
        "//utils/constants",
        "//utils/set",
        "//vms/evm/predicate",
        "//vms/platformvm/warp",
        "//vms/platformvm/warp/payload",
        "//vms/saevm/warp",
        "//vms/saevm/warp/warptest",
        "@com_github_ava_labs_libevm//common",
        "@com_github_ava_labs_libevm//core/types",
        "@com_github_stretchr_testify//require",
        "@org_uber_go_goleak//:goleak",
    ],
)

package(default_visibility = [
    "//vms/saevm/cchain:__subpackages__",
    "//vms/saevm/cchain:external_consumers",
])
