        "client.go",
        "peer_tracker.go",
    ],
    importpath = "github.com/ava-labs/avalanchego/network/p2p/tracking",
    visibility = ["//visibility:public"],
    deps = [
        "//ids",
        "//network/p2p",
        "//utils/heap",
        "//utils/logging",
        "//utils/math",
        "//utils/set",
        "//version",
        "@com_github_prometheus_client_golang//prometheus",
        "@org_uber_go_zap//:zap",
    ],
)

