load("@rules_distroless//distroless:defs.bzl", "cacerts")
load("@rules_img//img:image.bzl", "image_from_binary", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_img_images.bzl", "image")

package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

# rules_distroless extracts Debian packages without running their maintainer
# scripts. Generate the certificate bundle that ca-certificates would create.
cacerts(
    name = "ca_certificates_amd64",
    package = "@bookworm_builder_amd64//ca-certificates:data",
)

cacerts(
    name = "ca_certificates_arm64",
    package = "@bookworm_builder_arm64//ca-certificates:data",
)

image_layer(
    name = "bazel_layer_amd64",
    srcs = {
        "/usr/local/bin/bazel": "@bazel_8_8_0_linux_amd64//file",
    },
    file_metadata = {
        "/usr/local/bin/bazel": file_metadata(mode = "0755"),
    },
)

image_layer(
    name = "bazel_layer_arm64",
    srcs = {
        "/usr/local/bin/bazel": "@bazel_8_8_0_linux_arm64//file",
    },
    file_metadata = {
        "/usr/local/bin/bazel": file_metadata(mode = "0755"),
    },
)

# Each builder runs natively and uses Debian's cross compiler for the other
# target architecture. This avoids emulating Bazel itself on arm64 hosts.
image_manifest(
    name = "builder_amd64",
    base = image("debian_12_slim"),
    entrypoint = [],
    env = {
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
    },
    layers = [
        "@bookworm_builder_amd64//:flat",
        ":ca_certificates_amd64",
        ":bazel_layer_amd64",
    ],
    platform = ":linux_amd64",
    # The Debian builder image exceeds the remote cache proxy upload limit.
    tags = ["no-remote-cache"],
    working_dir = "/workspace",
)

image_manifest(
    name = "builder_arm64",
    base = image("debian_12_slim"),
    entrypoint = [],
    env = {
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
    },
    layers = [
        "@bookworm_builder_arm64//:flat",
        ":ca_certificates_arm64",
        ":bazel_layer_arm64",
    ],
    platform = ":linux_arm64",
    tags = ["no-remote-cache"],
    working_dir = "/workspace",
)

image_load(
    name = "load_builder_amd64",
    image = ":builder_amd64",
    tag = "docker.io/library/avalanchego-bazel-builder:local",
    tags = ["no-remote-cache"],
)

image_load(
    name = "load_builder_arm64",
    image = ":builder_arm64",
    tag = "docker.io/library/avalanchego-bazel-builder:local",
    tags = ["no-remote-cache"],
)

# Keep the runtime image definition separate from the builder image. The
# image index transitions the executable build to each listed target platform.
image_from_binary(
    name = "avalanchego",
    base = image("debian_12_slim"),
    binary = "//main:avalanchego",
    cmd = ["./avalanchego"],
    entrypoint = [],
    include_runfiles = False,
    path = "/avalanchego/build/avalanchego",
    platforms = [
        ":linux_amd64",
        ":linux_arm64",
    ],
    # Cache the binary actions. Do not cache the large OCI layer or index actions.
    tags = ["no-remote-cache"],
    working_dir = "/avalanchego/build",
)

# Test mode starts a disposable registry at this address and pushes the index
# plus both platform manifests to it.
image_push(
    name = "push_avalanchego",
    image = ":avalanchego",
    registry = "localhost:5000",
    repository = "avalanchego-bazel",
    tag = "test",
    tags = ["no-remote-cache"],
)
