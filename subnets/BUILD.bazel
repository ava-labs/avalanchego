load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "go_test")

go_library(
    name = "subnets",
    srcs = [
        "config.go",
        "large_messages.go",
        "member_ca.go",
        "no_op_allower.go",
        "subnet.go",
    ],
    importpath = "github.com/ava-labs/avalanchego/subnets",
    visibility = ["//visibility:public"],
    deps = [
        "//ids",
        "//network/throttling",
        "//snow/consensus/simplex",
        "//snow/consensus/snowball",
        "//snow/engine/common",
        "//utils/constants",
        "//utils/set",
    ],
)

go_test(
    name = "subnets_test",
    srcs = [
        "config_test.go",
        "large_messages_test.go",
        "member_ca_test.go",
        "subnet_test.go",
    ],
    embed = [":subnets"],
    deps = [
        "//ids",
        "//network/throttling",
        "//snow/consensus/simplex",
        "//snow/consensus/snowball",
        "//staking/stakingtest",
        "//utils/constants",
        "//utils/set",
        "//utils/units",
        "@com_github_stretchr_testify//require",
    ],
)
