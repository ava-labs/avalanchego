load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "go_test")

go_library(
    name = "subnets",
    srcs = [
        "config.go",
        "config_membership.go",
        "membership.go",
        "membership_ca.go",
        "membership_crl.go",
        "no_op_allower.go",
        "subnet.go",
    ],
    importpath = "github.com/ava-labs/avalanchego/subnets",
    visibility = ["//visibility:public"],
    deps = [
        "//ids",
        "//snow/consensus/simplex",
        "//snow/consensus/snowball",
        "//snow/engine/common",
        "//staking",
        "//utils/set",
    ],
)

go_test(
    name = "subnets_test",
    srcs = [
        "config_test.go",
        "membership_ca_test.go",
        "membership_crl_test.go",
        "membership_test.go",
        "subnet_test.go",
    ],
    embed = [":subnets"],
    deps = [
        "//ids",
        "//snow/consensus/simplex",
        "//snow/consensus/snowball",
        "//staking/stakingtest",
        "//utils/set",
        "@com_github_stretchr_testify//require",
    ],
)
