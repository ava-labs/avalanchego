load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "go_test")

go_library(
    name = "simplex",
    srcs = ["parameters.go"],
    importpath = "github.com/ava-labs/avalanchego/snow/consensus/simplex",
    visibility = ["//visibility:public"],
    deps = [
        "//ids",
        "//utils/crypto/bls",
        "//utils/set",
    ],
)

go_test(
    name = "simplex_test",
    srcs = ["parameters_test.go"],
    embed = [":simplex"],
    deps = [
        "//ids",
        "//utils/crypto/bls",
        "//utils/crypto/bls/signer/localsigner",
        "@com_github_stretchr_testify//require",
    ],
)
